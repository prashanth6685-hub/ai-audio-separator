# Copy to .env and adjust. All values optional; defaults are dev-friendly.
# Every variable is prefixed with AUDIOAPP_.

# Where uploads, job outputs and the sqlite DB live.
AUDIOAPP_DATA_DIR=./data

# Upload limits
AUDIOAPP_MAX_UPLOAD_MB=200
AUDIOAPP_MAX_DURATION_S=600

# Retention (hours): uploads without jobs, and finished job results.
AUDIOAPP_UPLOAD_TTL_HOURS=2
AUDIOAPP_RESULTS_TTL_HOURS=24
AUDIOAPP_RETENTION_SWEEP_S=300

# Worker: keep 1 on CPU. Raise only with GPU workers.
AUDIOAPP_SEPARATOR_WORKERS=1
AUDIOAPP_MAX_RETRIES=1
AUDIOAPP_JOB_TIMEOUT_S=3600

# Model: htdemucs (default) | htdemucs_ft | htdemucs_6s
# Device: auto | cpu | cuda
AUDIOAPP_DEMUCS_MODEL=htdemucs
AUDIOAPP_DEVICE=auto

# CORS origins for the frontend dev server
AUDIOAPP_CORS_ORIGINS=["http://localhost:3000"]

AUDIOAPP_LOG_LEVEL=INFO
